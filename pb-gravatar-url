#!/usr/bin/env python3
"""Gravatar URL for the email address in the macOS clipboard."""

from __future__ import annotations

import hashlib
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import copy, die, notify, paste

EMAIL_RE = re.compile(r"^[\w!#$%&'*+/=?^`{|}~.\-]+@[\w\-]+(?:\.[\w\-]+)+$")


def gravatar_url(email: str) -> str:
    """Return the Gravatar URL for `email`."""
    digest = hashlib.md5(
        email.strip().lower().encode(), usedforsecurity=False
    ).hexdigest()
    return f"https://gravatar.com/avatar/{digest}"


def is_email(text: str) -> bool:
    """Whether `text` looks like an email address."""
    return bool(EMAIL_RE.match(text.strip()))


def main() -> None:
    """Turn the clipboard's email address into its Gravatar URL."""
    clipboard = paste()
    if not is_email(clipboard):
        die(f"I need something that looks like an email address:\n{clipboard}")
    result = gravatar_url(clipboard)
    copy(result)
    notify(result)


if __name__ == "__main__":
    main()
