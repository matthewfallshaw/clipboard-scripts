#!/usr/bin/env python3
"""Word count the clipboard on macOS (characters first, then words)."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import notify, paste  # noqa: E402
from textstats import count_chars, count_words  # noqa: E402


def char_count_message(text: str) -> str:
    """Build the "{chars} characters\\n({words} words)" notification message."""
    return f"{count_chars(text)} characters\n({count_words(text)} words)"


if __name__ == "__main__":
    notify(char_count_message(paste()))
