#!/usr/bin/env python3
"""Copy the Finder selection's POSIX path to the clipboard."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import LIB_DIR, notify, paste

FINDER_SCRIPT: Path = LIB_DIR / "copy-finder-path.scpt"


if __name__ == "__main__":
    # copy-finder-path.scpt sets the clipboard itself; we just report the result.
    subprocess.run(["/usr/bin/osascript", str(FINDER_SCRIPT)], check=True)
    notify(paste())
