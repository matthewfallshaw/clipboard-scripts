#!/usr/bin/env python3
"""Notify the current content of the clipboard."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import notify, paste

LONG_MESSAGE_LENGTH = 100


def is_long(text: str) -> bool:
    """Whether `text` is long enough to warrant a sticky notification."""
    return len(text) > LONG_MESSAGE_LENGTH


if __name__ == "__main__":
    content = paste()
    notify(content, sticky=is_long(content))
