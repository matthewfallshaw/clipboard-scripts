#!/usr/bin/env python3
"""ROT13 the contents of the macOS clipboard."""

from __future__ import annotations

import codecs
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import transform


def rot13(text: str) -> str:
    """Rotate ASCII letters by 13 places; everything else is untouched."""
    return codecs.encode(text, "rot13")


if __name__ == "__main__":
    # The old Ruby used a sticky notification (`clipboard(true) { ... }`).
    transform(rot13, sticky=True)
