#!/usr/bin/env python3
"""Put a new random 4-digit PIN in the clipboard, without displaying it."""

from __future__ import annotations

import secrets
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import copy, notify  # noqa: E402


def generate_pin() -> str:
    """Generate a random 4-digit PIN, zero-padded."""
    return f"{secrets.randbelow(10000):04d}"


if __name__ == "__main__":
    copy(generate_pin())
    notify("New pin in clipboard.")
