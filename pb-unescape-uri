#!/usr/bin/env python3
"""URI-unescape (percent-decode) the contents of the macOS clipboard."""

from __future__ import annotations

import sys
import urllib.parse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import transform


def unescape_uri(text: str) -> str:
    """Percent-decode text, matching the old Ruby `URI.unescape`."""
    return urllib.parse.unquote(text)


if __name__ == "__main__":
    transform(unescape_uri)
