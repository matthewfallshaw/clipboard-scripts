#!/usr/bin/env python3
"""Copy the Finder selection's path to the clipboard, shortened for readability."""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import LIB_DIR, transform  # noqa: E402

FINDER_SCRIPT: Path = LIB_DIR / "copy-finder-path.scpt"


def rewrite_finder_path(text: str) -> str:
    """Shorten a Finder POSIX path: home dir, Dropbox, and Google Drive.

    The Google Drive account is dropped — paths get shared within the org that
    owns the drive, so "GoogleDrive-matt@bellroy.com" is noise. What survives is
    the "My Drive" / "Shared drives" root, which is what tells them apart.
    """
    text = re.sub(r"/Users/.*?/", "~/", text)
    text = re.sub(r"~/Dropbox( \([^)]+?\))?/", "Dropbox:", text)
    text = re.sub(r"~/Library/CloudStorage/GoogleDrive-[^/]+/", "GoogleDrive:/", text)
    return text


if __name__ == "__main__":
    # copy-finder-path.scpt sets the clipboard itself; we then rewrite it in place.
    subprocess.run(["/usr/bin/osascript", str(FINDER_SCRIPT)], check=True)
    transform(rewrite_finder_path)
