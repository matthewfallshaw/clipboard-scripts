#!/usr/bin/env python3
"""Copy the Finder selection's path to the clipboard, shortened for readability."""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import LIB_DIR, transform  # noqa: E402

FINDER_SCRIPT: Path = LIB_DIR / "copy-finder-path.scpt"


GOOGLE_DRIVE_RE = re.compile(r"~/Library/CloudStorage/(GoogleDrive-[^/]+)/")


def _shorten_google_drive(match: "re.Match[str]") -> str:
    """Keep the account only where it disambiguates.

    A "Shared drives" path is owned by the org, so the account that reaches it
    is noise. "My Drive" is personal, and Matt has three accounts mounted, so
    dropping it there would make the path ambiguous.
    """
    account_dir = match.group(1)
    rest = match.string[match.end():]
    if rest.startswith("Shared drives"):
        return "GoogleDrive:/"
    return "%s:/" % account_dir


def rewrite_finder_path(text: str) -> str:
    """Shorten a Finder POSIX path: home dir, Dropbox, and Google Drive."""
    text = re.sub(r"/Users/.*?/", "~/", text)
    text = re.sub(r"~/Dropbox( \([^)]+?\))?/", "Dropbox:", text)
    text = GOOGLE_DRIVE_RE.sub(_shorten_google_drive, text)
    return text


if __name__ == "__main__":
    # copy-finder-path.scpt sets the clipboard itself; we then rewrite it in place.
    subprocess.run(["/usr/bin/osascript", str(FINDER_SCRIPT)], check=True)
    transform(rewrite_finder_path)
