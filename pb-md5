#!/usr/bin/env python3
# MD5 hasherize the contents of the macOS clipboard

import hashlib
import os
import subprocess


def md5_hex(text: str) -> str:
    return hashlib.md5(text.encode()).hexdigest()


def main() -> None:
    content: str = subprocess.run(
        ["pbpaste"], capture_output=True, text=True
    ).stdout
    result: str = md5_hex(content)
    subprocess.run(["pbcopy"], input=result, text=True)
    notify_path: str = os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "lib", "notify"
    )
    subprocess.run([notify_path, result])


if __name__ == "__main__":
    main()
