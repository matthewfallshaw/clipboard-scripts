#!/usr/bin/env python3
"""Sentence-case the clipboard on macOS.

Uses Claude (Haiku) when the `claude` CLI is available, because sentence casing
needs to know which words are proper nouns. Falls back to a regex that only
capitalises sentence starts.

Set PB_DEBUG=1 to trace which path was taken.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Optional

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import copy, find_binary, notify, paste  # noqa: E402

CLAUDE_MODEL = "haiku"

# Observed round-trip is ~8s. Overrunning costs a hang, not money, and a slow
# answer beats falling back to the regex — so this sits well clear of normal.
CLAUDE_TIMEOUT_SECONDS = 60

CLAUDE_PROMPT = """Convert this text to sentence case. Rules:
- Capitalize the first letter of each sentence
- Capitalize proper nouns (people, places, brands, products)
- Lowercase everything else
- Preserve the original line breaks and spacing

Text:
"""

RESPONSE_SCHEMA = {
    "type": "object",
    "properties": {"text": {"type": "string"}},
    "required": ["text"],
}

FENCE_RE = re.compile(r"\A```(?:\w+)?\n(.*)\n```\Z", re.DOTALL)


def debug(message: str) -> None:
    if os.environ.get("PB_DEBUG"):
        print("[pb-sentence-case] %s" % message, file=sys.stderr)


def strip_code_fence(text: str) -> str:
    """Unwrap a fenced code block, which the model sometimes adds unasked."""
    match = FENCE_RE.match(text.strip())
    return match.group(1) if match else text


def simple_sentence_case(text: str) -> str:
    """Capitalise sentence starts. Knows nothing about proper nouns."""
    return re.sub(r"^.|(?<=\. ).", lambda m: m.group().upper(), text.lower())


def claude_sentence_case(text: str, claude: str) -> Optional[str]:
    """Sentence-case via Claude, or None if it didn't work out."""
    try:
        result = subprocess.run(
            [
                claude,
                "--model",
                CLAUDE_MODEL,
                "--print",
                "--output-format",
                "json",
                "--json-schema",
                json.dumps(RESPONSE_SCHEMA),
                CLAUDE_PROMPT + text,
            ],
            capture_output=True,
            text=True,
            timeout=CLAUDE_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        debug("timed out after %ss" % CLAUDE_TIMEOUT_SECONDS)
        return None

    if result.returncode != 0:
        debug("exit %s: %s" % (result.returncode, result.stderr[:200]))
        return None

    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        debug("undecodable response: %s" % error)
        return None

    cased = strip_code_fence(response.get("structured_output", {}).get("text", ""))
    if not cased.strip():
        debug("empty result")
        return None
    return cased


def sentence_case(text: str) -> str:
    """Sentence-case `text`, preferring Claude and falling back to the regex."""
    claude = find_binary("claude")
    if claude:
        cased = claude_sentence_case(text, claude)
        if cased:
            debug("used claude")
            return cased
        debug("claude gave nothing, falling back")
    else:
        debug("claude not found, falling back")
    return simple_sentence_case(text)


def main() -> None:
    content = paste()
    if not content.strip():
        notify("Nothing in the clipboard to sentence-case.")
        return
    result = sentence_case(content)
    copy(result)
    notify(result)


if __name__ == "__main__":
    main()
