#!/usr/bin/env python3
"""Put a new random password in the clipboard, and show alternatives.

Alternatives are offered via a sticky notification: several more generated
passwords, plus a run of random dictionary words for a memorable passphrase.
"""

from __future__ import annotations

import random
import re
import secrets
import string
import sys
from pathlib import Path
from typing import List, Optional

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import copy, notify  # noqa: E402

PWGEN_LENGTH = 20
ALTERNATE_PASSWORD_COUNT = 10
WORD_COUNT = 40

# Letters, digits, and a conservative punctuation set: safe to paste into
# shells, URLs, HTML forms, and CSV without needing escaping.
LOWER = string.ascii_lowercase
UPPER = string.ascii_uppercase
DIGITS = string.digits
PUNCTUATION = "!@#$%^&*-_=+"
CHAR_CLASSES = (LOWER, UPPER, DIGITS, PUNCTUATION)
ALL_CHARS = "".join(CHAR_CLASSES)


def _secure_shuffle(items: list) -> None:
    """Shuffle `items` in place using a cryptographically secure RNG."""
    for i in range(len(items) - 1, 0, -1):
        j = secrets.randbelow(i + 1)
        items[i], items[j] = items[j], items[i]


def generate_password(length: int = PWGEN_LENGTH) -> str:
    """Generate a random password containing at least one of each character class."""
    if length < len(CHAR_CLASSES):
        raise ValueError(
            f"length must be at least {len(CHAR_CLASSES)} to include all character classes"
        )
    chars = [secrets.choice(char_class) for char_class in CHAR_CLASSES]
    chars.extend(secrets.choice(ALL_CHARS) for _ in range(length - len(chars)))
    _secure_shuffle(chars)
    return "".join(chars)


def find_wordlist() -> Optional[Path]:
    """Find the moby crossword wordlist under ~/Documents/wordlist*.

    Globs the directory name (rather than hardcoding it) so this keeps
    working if the wordlist directory is renamed, matching the old
    `find ~/Documents/wordlist* -iname '*crossword*'` behaviour.
    """
    documents = Path.home() / "Documents"
    if not documents.is_dir():
        return None
    for base in sorted(documents.glob("wordlist*")):
        if base.is_dir():
            matches = sorted(
                p for p in base.iterdir() if p.is_file() and "crossword" in p.name.lower()
            )
            if matches:
                return matches[0]
        elif base.is_file() and "crossword" in base.name.lower():
            return base
    return None


def clean_word(word: str) -> str:
    """Clean a raw wordlist line for display: downcase, strip noise chars."""
    word = word.lower()
    word = re.sub(r"['!&./0-9]", "", word)
    word = re.sub(r"[\s\W]", "-", word, flags=re.ASCII)
    return word


def random_words(
    wordlist: Path, count: int = WORD_COUNT, rng: Optional[random.Random] = None
) -> List[str]:
    """Return `count` random cleaned words read from `wordlist`."""
    generator = rng if rng is not None else random
    with wordlist.open("r", encoding="utf-8", errors="replace") as fh:
        lines = fh.readlines()
    picked = generator.sample(lines, min(count, len(lines)))
    return [clean_word(line.strip()) for line in picked]


def build_message(alternate_passwords: List[str], words: List[str]) -> str:
    """Build the sticky notification body offering alternatives."""
    lines = ["New password in clipboard.", "", "Other options:"]
    lines.extend(f"    {pw}" for pw in alternate_passwords)
    if words:
        lines.append("")
        lines.append(" ".join(words))
    return "\n".join(lines)


if __name__ == "__main__":
    primary = generate_password(PWGEN_LENGTH)
    alternates = [generate_password(PWGEN_LENGTH) for _ in range(ALTERNATE_PASSWORD_COUNT)]
    wordlist = find_wordlist()
    words = random_words(wordlist, WORD_COUNT) if wordlist is not None else []
    copy(primary)
    notify(build_message(alternates, words), sticky=True)
