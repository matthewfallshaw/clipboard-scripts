#!/usr/bin/env python3
"""Open a Terminal running vidir in the Finder-selected directory."""

from __future__ import annotations

import shlex
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import LIB_DIR, notify, osascript, paste, require_binary

FINDER_SCRIPT: Path = LIB_DIR / "copy-finder-path.scpt"

TERMINAL_SCRIPT = """\
on run argv
    tell application "Terminal"
        do script (item 1 of argv)
        activate
    end tell
end run
"""


def target_directory(finder_path: str) -> str | None:
    """Pick the directory to vidir: the selected path, or its parent if it's a file.

    Returns None if `finder_path` doesn't exist (e.g. nothing was selected).
    """
    path = Path(finder_path)
    if not finder_path or not path.exists():
        return None
    if path.is_dir():
        return finder_path
    return str(path.parent)


if __name__ == "__main__":
    # copy-finder-path.scpt sets the clipboard to the Finder selection's path(s).
    subprocess.run(["/usr/bin/osascript", str(FINDER_SCRIPT)], check=True)
    tokens = paste().split()
    directory = target_directory(tokens[0] if tokens else "")
    if directory is None:
        notify(
            "You'll need to select a directory in Finder, then I can vidir it for you."
        )
        sys.exit(0)

    vidir = require_binary("vidir")
    command = f"{shlex.quote(vidir)} {shlex.quote(directory)}"
    osascript(TERMINAL_SCRIPT, [command])
