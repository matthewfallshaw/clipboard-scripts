#!/usr/bin/env python3
"""Put a random number in the clipboard."""

from __future__ import annotations

import random
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import transform

DEFAULT_MAXIMUM = 999999


def random_number(
    maximum: int = DEFAULT_MAXIMUM, rng: random.Random | None = None
) -> int:
    """Return a random integer in [1, maximum], inclusive."""
    generator = rng if rng is not None else random
    return generator.randint(1, maximum)


if __name__ == "__main__":
    maximum = int(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_MAXIMUM
    transform(lambda _clipboard: str(random_number(maximum)))
