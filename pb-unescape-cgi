#!/usr/bin/env python3
"""CGI-unescape (application/x-www-form-urlencoded) the macOS clipboard."""

from __future__ import annotations

import sys
import urllib.parse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import transform  # noqa: E402


def unescape_cgi(text: str) -> str:
    """Decode a form-urlencoded string back to plain text."""
    return urllib.parse.unquote_plus(text)


if __name__ == "__main__":
    transform(unescape_cgi)
