#!/usr/bin/env python3
"""CGI-escape (application/x-www-form-urlencoded) the macOS clipboard."""

from __future__ import annotations

import sys
import urllib.parse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import transform


def escape_cgi(text: str) -> str:
    """Percent-encode text for use in a form-urlencoded query string."""
    return urllib.parse.quote_plus(text)


if __name__ == "__main__":
    transform(escape_cgi)
