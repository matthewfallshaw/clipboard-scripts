#!/usr/bin/env python3
"""Wrap the clipboard in double quotes, demoting any quotes inside it to single."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import transform


def fix_nested_quotes(text: str) -> str:
    """Double-quote `text`, turning double quotes within it into single quotes."""
    inner = text[1:-1] if text.startswith('"') and text.endswith('"') else text
    return '"{}"'.format(inner.replace('"', "'"))


if __name__ == "__main__":
    transform(fix_nested_quotes)
