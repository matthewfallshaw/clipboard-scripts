#!/usr/bin/env python3
"""Word count the clipboard on macOS."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

from pbclip import notify, paste  # noqa: E402
from textstats import count_chars, count_words  # noqa: E402


def word_count_message(text: str) -> str:
    """Build the "{words} words\\n({chars} characters)" notification message."""
    return f"{count_words(text)} words\n({count_chars(text)} characters)"


if __name__ == "__main__":
    notify(word_count_message(paste()))
