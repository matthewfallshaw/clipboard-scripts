#!/usr/bin/env python3
"""Word count the clipboard on macOS."""

import os
import re
import subprocess
import sys


def count_words(text: str) -> int:
    """Count words using Ruby-compatible [\\w-]+ pattern.

    Hyphenated words count as single words. Underscores are word characters.
    """
    return len(re.findall(r'[\w-]+', text))


def count_chars(text: str) -> int:
    """Count characters in text."""
    return len(text)


def main() -> None:
    content: str = subprocess.run(
        ['pbpaste'], capture_output=True, text=True
    ).stdout
    words: int = count_words(content)
    chars: int = count_chars(content)
    message: str = f"{words} words\n({chars} characters)"
    notify_path: str = os.path.join(
        os.path.dirname(os.path.abspath(__file__)), 'lib', 'notify'
    )
    subprocess.run([notify_path, message])


if __name__ == '__main__':
    main()
